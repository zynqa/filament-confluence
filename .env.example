JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence Integration
CONFLUENCE_CONNECTION=mcp
CONFLUENCE_CLOUD_ID=
CONFLUENCE_URL=https://your-domain.atlassian.net
# REST calls; a scoped service-account token needs https://api.atlassian.com/ex/confluence/<cloudId>
CONFLUENCE_API_URL=
# Optional extra limit: comma-separated space keys the knowledge base may read; empty allows all
# (users still only see their own assigned spaces and pages)
CONFLUENCE_ALLOWED_SPACES=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_CONTENT_FORMAT=markdown
